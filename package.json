{
  "name": "billpay",
  "version": "1.2.0",
  "private": true,
  "description": "BillPay — напоминания о регулярных платежах команды. Node.js + PostgreSQL, docker compose для продакшена.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "bot": "node src/bot.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "test": "node --test --test-concurrency=1 tests/",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db",
    "reset": "node src/reset.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.6.1"
  },
  "scarfSettings": {
    "enabled": false
  }
}
